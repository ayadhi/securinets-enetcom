---
import Layout from '../layouts/Layout.astro';
import workshops from '../data/workshops.json';

const sorted = [...workshops].sort((a, b) => a.date.localeCompare(b.date));
---

<Layout title="Workshops - Securinets ENET'COM">
  <section class="py-16">
    <h1 class="text-4xl font-bold">Work<span class="text-brand-orange">shops</span></h1>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {sorted.map((w) => (
        <article class="card-glow gborder rounded-2xl bg-card p-6">
          <span class="rounded-full bg-brand-blue px-3 py-1 text-xs">{w.level}</span>
          <h2 class="mt-3 text-xl font-semibold">{w.title}</h2>
          <p class="mt-1 text-sm text-white/60">{w.date} · {w.speaker}</p>
          <p class="mt-3 text-white/80">{w.description}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>
