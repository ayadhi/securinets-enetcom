---
import Layout from '../layouts/Layout.astro';
import team from '../data/team.json';
---

<Layout title="Team - Securinets ENET'COM">
  <section class="py-16">
    <h1 class="text-4xl font-bold">Our <span class="text-brand-orange">team</span></h1>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {team.map((m) => (
        <article class="rounded-2xl border border-white/10 bg-card p-6 text-center">
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-brand-blue text-2xl font-bold">
            {m.name.split(' ').map((p) => p[0]).join('').slice(0, 2)}
          </div>
          <h2 class="mt-4 text-lg font-semibold">{m.name}</h2>
          <p class="text-sm text-brand-orange">{m.role}</p>
          <div class="mt-3 flex justify-center gap-4 text-sm text-white/60">
            {m.github && <a href={`https://github.com/${m.github}`} class="hover:text-white">GitHub</a>}
            {m.linkedin && <a href={m.linkedin} class="hover:text-white">LinkedIn</a>}
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
