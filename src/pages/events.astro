---
import Layout from '../layouts/Layout.astro';
import events from '../data/events.json';

const today = new Date().toISOString().slice(0, 10);
const MONTHS = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];

const statusOf = (e: any) =>
  e.status === 'ongoing' ? 'ongoing' : e.date && e.date < today ? 'past' : e.date ? 'upcoming' : e.status;

const all = events.map((e: any) => ({
  ...e,
  s: statusOf(e),
  day: e.date ? e.date.slice(8, 10) : '',
  mon: e.date ? MONTHS[Number(e.date.slice(5, 7)) - 1] : '',
  year: e.date ? e.date.slice(0, 4) : '',
}));

const ongoing = all.filter((e) => e.s === 'ongoing');
const upcoming = all.filter((e) => e.s === 'upcoming').sort((a, b) => a.date.localeCompare(b.date));
const past = all.filter((e) => e.s === 'past').sort((a, b) => b.date.localeCompare(a.date));

const next = upcoming[0];
const others = upcoming.slice(1);
const startTime = next ? (next.time.match(/\d{1,2}:\d{2}/)?.[0] ?? '00:00').padStart(5, '0') : '';
const weekday = next ? new Date(next.date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'long' }) : '';
const target = next ? `${next.date}T${startTime}:00` : '';
---

<Layout title="Events - Securinets ENET'COM" description="CTFs, plateformes et events du club Securinets ENET'COM.">
  <section class="pb-10 pt-16">
    <h1 class="animate-fade-up max-w-3xl text-5xl font-bold leading-[1.05] tracking-tight md:text-7xl">
      CTFs, workshops <span class="text-white/80">and</span><br />
      <span class="text-brand-gradient">everything in between.</span>
    </h1>
    <p class="animate-fade-up mt-6 max-w-xl text-white/60" style="animation-delay:.15s">
      Everything the club runs, in one calendar. New events are posted here first.
    </p>
  </section>

  {next && (
    <section class="reveal pb-16">
      <div class="snow-card relative overflow-hidden rounded-[2rem] border">
        <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-brand-blue/50 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-32 -left-20 h-80 w-80 rounded-full bg-brand-orange/20 blur-3xl"></div>

        <canvas class="snow" aria-hidden="true"></canvas>
        <div class="relative z-10 grid gap-10 p-8 pt-16 md:grid-cols-[1fr_1.5fr] md:p-14 md:pt-20">
          <div class="flex flex-col justify-between gap-8">
            {next.poster ? (
              <img src={next.poster} alt={next.title} onerror="this.style.display='none'"
                class="w-full rounded-2xl border border-white/10 object-cover shadow-[0_0_50px_rgba(240,80,30,0.25)]" />
            ) : <div></div>}
            <div>
              <p class="text-8xl font-extrabold leading-none tracking-tighter md:text-9xl">
                <span class="frost">{next.day}</span><span class="warm">.</span><span class="frost">{String(next.date.slice(5, 7))}</span>
              </p>
              <p class="mt-3 text-lg text-white/60">{weekday}{startTime ? `, ${startTime}` : ''}</p>
            </div>
          </div>

          <div>
            <span class="inline-block rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-sm text-white/80">
              ❄️ CTF, Beginner friendly
            </span>
            <h2 class="frost mt-6 text-5xl font-bold leading-[1.05] tracking-tight md:text-6xl">{next.title}</h2>
            <p class="mt-4 text-white/60">📍 {next.location}</p>
            <p class="mt-5 max-w-xl leading-relaxed text-white/70">{next.description}</p>

            {next.categories.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2">
                {next.categories.map((c: string) => (
                  <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs text-white/80">{c}</span>
                ))}
              </div>
            )}

            {next.entry && (
              <p class="mt-6 text-white/60">Entry <span class="font-semibold text-white">{next.entry}</span></p>
            )}

            <div id="countdown" data-target={target} class="mt-8 grid max-w-sm grid-cols-4 gap-3 text-center">
              {['Jours','Heures','Min','Sec'].map((l) => (
                <div class="rounded-xl border border-white/10 bg-bg/60 py-3">
                  <p class="cd-num text-2xl font-bold tabular-nums">--</p>
                  <p class="text-[10px] uppercase tracking-wider text-white/50">{l}</p>
                </div>
              ))}
            </div>

            <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
              {next.link ? (
                <a href={next.link} target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-full bg-white px-7 py-3 font-semibold text-black transition hover:opacity-90">
                  Get your ticket <span>↗</span>
                </a>
              ) : (
                <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-7 py-3 font-semibold text-white/80">
                  Registration coming soon…
                </span>
              )}
              <a href="/join" class="text-sm text-white/50 hover:text-white">Not sure yet? Tell us you might come</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  {ongoing.length > 0 && (
    <section class="reveal pb-16">
      <h2 class="mb-6 text-xl font-semibold text-white/80"><span class="text-brand-orange">/</span> En cours</h2>
      <div class="grid gap-6">
        {ongoing.map((e) => (
          <article class="cyber-card rounded-3xl p-8 md:p-12">
            <span class="hud tl"></span><span class="hud tr"></span><span class="hud bl"></span><span class="hud br"></span>
            <p class="cyber-text text-sm text-brand-orange">// ANNOUNCING</p>
            <h3 class="cyber-text cyber-title mt-3 text-5xl font-extrabold uppercase md:text-7xl">{e.title}</h3>
            <p class="cyber-text mt-4 flex items-center gap-2 text-lg text-white/85">
              <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-green-400"></span>
              &gt; THE PLATFORM IS LIVE<span class="cursor"></span>
            </p>
            <div class="cyber-text mt-6 grid max-w-md grid-cols-2 gap-3 text-center">
              <div class="rounded-lg border border-brand-orange/40 bg-black/30 py-3"><p class="text-3xl font-bold text-brand-orange">+10</p><p class="text-xs text-white/60">PROJECTS</p></div>
              <div class="rounded-lg border border-brand-orange/40 bg-black/30 py-3"><p class="text-3xl font-bold text-brand-orange">+10</p><p class="text-xs text-white/60">GROUPS</p></div>
            </div>
            <p class="mt-6 max-w-2xl text-white/75">{e.description}</p>
            <div class="mt-7 flex flex-wrap items-center gap-4">
              <a href="/projects" class="rounded-full bg-brand-orange px-7 py-3 font-semibold text-white hover:opacity-90">Voir les projets →</a>
              {e.link && <a href={e.link} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/25 px-7 py-3 font-semibold hover:bg-white/10">Open platform ↗</a>}
            </div>
            <p class="cyber-text mt-8 text-xs tracking-[0.3em] text-white/50">SECURE. DEFEND. <span class="text-brand-orange">INNOVATE.</span></p>
          </article>
        ))}
      </div>
    </section>
  )}

  {others.length > 0 && (
    <section class="reveal pb-16">
      <h2 class="mb-6 text-xl font-semibold text-white/80"><span class="text-brand-orange">/</span> À venir</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {others.map((e) => (
          <article class="card-glow rounded-2xl border border-white/10 bg-card p-6">
            <p class="text-4xl font-extrabold">{e.day}<span class="text-brand-orange">.</span>{e.mon}</p>
            <h3 class="mt-3 text-xl font-semibold">{e.title}</h3>
            <p class="mt-1 text-sm text-white/60">{e.type} · {e.location}</p>
            <p class="mt-3 text-white/80">{e.description}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {past.length > 0 && (
    <section class="reveal pb-16">
      <h2 class="mb-8 text-xl font-semibold text-white/80"><span class="text-brand-orange">/</span> Passés</h2>
      <ol class="relative ml-3 border-l border-white/15">
        {past.map((e) => (
          <li class="mb-10 ml-8">
            <span class="absolute -left-[7px] mt-2 h-3.5 w-3.5 rounded-full border-2 border-bg bg-brand-gradient"></span>
            <div class="card-glow flex flex-col gap-4 rounded-2xl border border-white/10 bg-card p-5 sm:flex-row">
              {e.poster ? (
                <img src={e.poster} alt={e.title} loading="lazy" onerror="this.style.display='none'"
                  class="h-32 w-full rounded-xl object-cover sm:w-48" />
              ) : null}
              <div>
                <p class="text-xs uppercase tracking-wider text-white/50">{e.day} {e.mon} {e.year} · {e.type}</p>
                <h3 class="mt-1 text-xl font-semibold">{e.title}</h3>
                <p class="mt-1 text-sm text-white/60">📍 {e.location}</p>
                <p class="mt-2 text-sm text-white/75">{e.description}</p>
                {e.categories.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {e.categories.map((c: string) => (
                      <span class="rounded-full border border-white/15 px-2.5 py-0.5 text-[11px] text-white/60">{c}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  <script>
    const el = document.getElementById('countdown');
    if (el) {
      const target = new Date(el.dataset.target || '').getTime();
      const nums = el.querySelectorAll('.cd-num');
      const tick = () => {
        let d = Math.max(0, target - Date.now());
        const days = Math.floor(d / 864e5); d %= 864e5;
        const h = Math.floor(d / 36e5); d %= 36e5;
        const m = Math.floor(d / 6e4);
        const s = Math.floor((d % 6e4) / 1e3);
        [days, h, m, s].forEach((v, i) => (nums[i].textContent = String(v).padStart(2, '0')));
      };
      tick();
      setInterval(tick, 1000);
    }
  </script>

  <script>
    const card = document.querySelector('.snow-card');
    const cv = card?.querySelector('canvas.snow') as HTMLCanvasElement | null;
    if (card && cv && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const ctx = cv.getContext('2d')!;
      let w = 0, h = 0;
      const fit = () => { w = cv.width = card.clientWidth; h = cv.height = card.clientHeight; };
      fit(); addEventListener('resize', fit);
      const flakes = Array.from({ length: 110 }, () => ({
        x: Math.random() * 1000, y: Math.random() * 600,
        r: Math.random() * 2.6 + 0.8, v: Math.random() * 0.8 + 0.4, d: Math.random() * Math.PI * 2,
      }));
      const loop = () => {
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = 'rgba(255,255,255,0.85)';
        for (const f of flakes) {
          f.y += f.v; f.d += 0.01; f.x += Math.sin(f.d) * 0.5;
          if (f.y > h) { f.y = -5; f.x = Math.random() * w; }
          if (f.x > w) f.x = 0;
          ctx.beginPath(); ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2); ctx.fill();
        }
        requestAnimationFrame(loop);
      };
      loop();
    }
  </script>
</Layout>
