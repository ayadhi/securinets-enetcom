---
import Layout from '../layouts/Layout.astro';
import events from '../data/events.json';

const today = new Date().toISOString().slice(0, 10);
const next = [...events]
  .filter((e) => e.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date))[0];

const startTime = next ? ((next.time || '').match(/\d{1,2}:\d{2}/)?.[0] ?? '00:00').padStart(5, '0') : '';
const target = next ? `${next.date}T${startTime}:00` : '';
const MONTHS = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];

const fields = [
  { name: 'Web', desc: 'XSS, SQLi, auth, logique applicative.' },
  { name: 'Crypto', desc: 'RSA, XOR, AES w les erreurs classiques.' },
  { name: 'Forensics', desc: 'Analyse de fichiers, mémoire, réseau.' },
  { name: 'Reverse', desc: 'Comprendre w casser les binaires.' },
  { name: 'Pwn', desc: 'Exploitation binaire, buffer overflow.' },
  { name: 'OSINT & Misc', desc: 'Recherche, stégano, puzzles.' },
];
---

<Layout title="Securinets ENET'COM">
  <!-- Hero -->
  <section class="flex min-h-[75vh] flex-col items-center justify-center text-center">
    <img
      src="/securinets-logo.png"
      alt="Securinets"
      class="animate-float h-52 w-auto object-contain drop-shadow-[0_0_25px_rgba(120,150,255,0.45)]"
    />
    <h1 class="animate-fade-up mt-6 text-5xl font-bold md:text-6xl">
      Securinets <span class="text-brand-gradient">ENET'COM</span>
    </h1>
    <p class="cursor animate-fade-up mt-4 max-w-xl text-white/70" style="animation-delay:.2s">CTFs, workshops w kol chy fil cybersecurity</p>
    <div class="mt-8 flex gap-4">
      <a href="/join" class="rounded-full bg-brand-gradient px-6 py-3 font-semibold text-white hover:opacity-90">Join the club</a>
      <a href="/events" class="rounded-full border border-white/20 px-6 py-3 font-semibold text-white hover:bg-white/10">Events</a>
    </div>
  </section>

  <!-- About -->
  <section class="reveal py-16">
    <h2 class="text-3xl font-bold">À <span class="text-brand-orange">propos</span> <a href="/about" class="ml-3 text-sm font-normal text-brand-orange hover:underline">En savoir plus →</a></h2>
    <p class="mt-4 max-w-3xl text-white/75">
      Securinets ENET'COM howa el club de cybersécurité mta3 l'École Nationale d'Électronique
      et des Télécommunications de Sfax. N'organisiw workshops, CTFs w sessions d'entraînement
      bech nwaslou men el théorie lel pratique, m3a el comunauté Securinets fi Tunisie.
    </p>
  </section>

  <!-- Fields -->
  <section class="reveal py-8">
    <h2 class="text-3xl font-bold">Nos <span class="text-brand-orange">domaines</span></h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {fields.map((f) => (
        <article class="card-glow gborder rounded-2xl bg-card p-6">
          <h3 class="text-lg font-semibold">{f.name}</h3>
          <p class="mt-2 text-sm text-white/70">{f.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Next event -->
  {next && (
    <section class="reveal py-16">
      <h2 class="text-3xl font-bold">Next <span class="text-brand-orange">event</span></h2>
      <article class="snow-card relative mt-6 overflow-hidden rounded-[2rem] border">
        <canvas class="snow" aria-hidden="true"></canvas>
        <div class="relative z-10 grid gap-8 p-8 pt-16 md:grid-cols-[1.4fr_1fr] md:p-12 md:pt-20">
          <div>
            <span class="inline-block rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-sm text-white/80">❄️ {next.type}</span>
            <h3 class="frost mt-5 text-4xl font-bold leading-tight md:text-5xl">{next.title}</h3>
            <p class="mt-3 text-white/60">📍 {next.location}{next.time ? ` · ${next.time}` : ''}</p>
            <p class="mt-4 max-w-xl text-white/75">{next.description}</p>
            <div class="mt-7 flex flex-wrap items-center gap-4">
              <a href="/events" class="rounded-full bg-white px-6 py-2.5 font-semibold text-black hover:opacity-90">Voir l'event ↗</a>
              {next.link && (
                <a href={next.link} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/25 px-6 py-2.5 font-semibold hover:bg-white/10">Register</a>
              )}
            </div>
          </div>

          <div class="flex flex-col items-center justify-center">
            <p class="text-7xl font-extrabold leading-none tracking-tighter md:text-8xl">
              <span class="frost">{next.date.slice(8, 10)}</span><span class="warm">.</span><span class="frost">{next.date.slice(5, 7)}</span>
            </p>
            <div id="home-countdown" data-target={target} class="mt-6 grid w-full max-w-xs grid-cols-4 gap-2 text-center">
              {['Jours','Heures','Min','Sec'].map((l) => (
                <div class="rounded-xl border border-white/10 bg-bg/60 py-2.5">
                  <p class="cd-num text-2xl font-bold tabular-nums">--</p>
                  <p class="text-[10px] uppercase tracking-wider text-white/50">{l}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </article>
    </section>
  )}

  <!-- CTA -->
  <section class="reveal py-16 text-center">
    <h2 class="text-3xl font-bold">Ready to <span class="text-brand-gradient">hack</span>?</h2>
    <p class="mt-3 text-white/70">Rejoins el club w commenci tet3alem m3ana.</p>
    <a href="/join" class="mt-6 inline-block rounded-full bg-brand-gradient px-8 py-3 font-semibold text-white hover:opacity-90">Join the club</a>
  </section>
</Layout>

<script>
  const el = document.getElementById('home-countdown');
  if (el) {
    const target = new Date(el.dataset.target || '').getTime();
    const nums = el.querySelectorAll('.cd-num');
    const tick = () => {
      let d = Math.max(0, target - Date.now());
      const days = Math.floor(d / 864e5); d %= 864e5;
      const h = Math.floor(d / 36e5); d %= 36e5;
      const m = Math.floor(d / 6e4);
      const sec = Math.floor((d % 6e4) / 1e3);
      [days, h, m, sec].forEach((v, i) => (nums[i].textContent = String(v).padStart(2, '0')));
    };
    tick();
    setInterval(tick, 1000);
  }

  const card = document.querySelector('.snow-card');
  const cv = card?.querySelector('canvas.snow') as HTMLCanvasElement | null;
  if (card && cv && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = cv.getContext('2d')!;
    let w = 0, h = 0;
    const fit = () => { w = cv.width = card.clientWidth; h = cv.height = card.clientHeight; };
    fit(); addEventListener('resize', fit);
    const flakes = Array.from({ length: 90 }, () => ({
      x: Math.random() * 1000, y: Math.random() * 600,
      r: Math.random() * 2.6 + 0.8, v: Math.random() * 0.8 + 0.4, d: Math.random() * Math.PI * 2,
    }));
    const loop = () => {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = 'rgba(255,255,255,0.85)';
      for (const f of flakes) {
        f.y += f.v; f.d += 0.01; f.x += Math.sin(f.d) * 0.5;
        if (f.y > h) { f.y = -5; f.x = Math.random() * w; }
        if (f.x > w) f.x = 0;
        ctx.beginPath(); ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2); ctx.fill();
      }
      requestAnimationFrame(loop);
    };
    loop();
  }
</script>
