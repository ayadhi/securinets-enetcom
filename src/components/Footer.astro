---
import { links } from '../lib/links';

const explore = [
  { label: 'Home', href: '/' },
  { label: 'About us', href: '/about' },
  { label: 'Events', href: '/events' },
  { label: 'Workshops', href: '/workshops' },
  { label: 'The team', href: '/team' },
  { label: 'Join the club', href: '/join' },
];

const socials = [
  {
    label: 'Instagram',
    href: links.instagram,
    svg: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/>',
  },
  {
    label: 'Facebook',
    href: links.facebook,
    svg: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  },
  {
    label: 'TikTok',
    href: links.tiktok,
    svg: '<path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>',
  },
  {
    label: 'GitHub',
    href: links.github,
    svg: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  },
  {
    label: 'Discord',
    href: links.discord,
    svg: '<path d="M8 8c2.5-1 5.5-1 8 0M7 17c3 1.5 7 1.5 10 0M6 8c-1.5 3-2 6-1.5 9 1 .8 2.2 1.4 3.5 1.8l1-1.8M18 8c1.5 3 2 6 1.5 9-1 .8-2.2 1.4-3.5 1.8l-1-1.8"/><circle cx="9.5" cy="13" r="1"/><circle cx="14.5" cy="13" r="1"/>',
  },
].filter((s) => s.href);
---

<footer class="mt-24 border-t border-white/10">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <!-- Brand -->
    <div>
      <a href="/" class="flex items-center gap-3 font-semibold">
        <img src="/securinets-logo.png" alt="" class="h-9 w-auto object-contain" />
        <span>Securinets <span class="text-brand-orange">ENET'COM</span></span>
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/60">
        The student cybersecurity club of ENET'COM Sfax.
        Learn. Explore. Secure. Repeat.
      </p>
    </div>

    <!-- Explore -->
    <div>
      <h3 class="text-sm font-semibold text-white">Explore</h3>
      <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 text-sm text-white/60">
        {explore.map((l) => (
          <li><a href={l.href} class="transition hover:text-brand-orange">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Get in touch -->
    <div>
      <h3 class="text-sm font-semibold text-white">Get in touch</h3>
      <ul class="mt-4 space-y-3 text-sm text-white/60">
        {links.email && (
          <li><a href={`mailto:${links.email}`} class="transition hover:text-brand-orange">{links.email}</a></li>
        )}
        <li>ENET'COM, Sfax, Tunisia</li>
      </ul>
      <div class="mt-5 flex items-center gap-4">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            class="text-white/60 transition hover:text-brand-orange"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={s.svg}
            />
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-5 text-xs text-white/50">
      <p>© 2026 Securinets ENET'COM. Built by members, for members.</p>
      <a href="#top" class="transition hover:text-white">Back to top ↑</a>
    </div>
  </div>
</footer>
